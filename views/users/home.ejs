<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Toffee Puddle | Home</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans">

  <!-- 🧭 Navbar -->
  <header class="bg-gradient-to-r from-pink-500 to-purple-500 text-white shadow-lg">
    <div class="max-w-7xl mx-auto flex justify-between items-center px-6 py-4">
      <h1 class="text-3xl font-extrabold tracking-tight">Toffee Puddle</h1>

      <nav class="hidden md:flex space-x-8 font-medium">
        <a href="#" class="hover:text-pink-200 transition">Home</a>
        <a href="#" class="hover:text-pink-200 transition">Shop</a>
        <a href="#" class="hover:text-pink-200 transition">About</a>
        <a href="#" class="hover:text-pink-200 transition">Contact</a>
      </nav>

      <button class="flex items-center bg-white text-pink-600 px-3 py-2 rounded-lg font-medium hover:bg-pink-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.293 1.293a1 1 0 00.707 1.707H19m0 0a2 2 0 100 4 2 2 0 000-4m-9 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Cart
      </button>
    </div>
  </header>

  <!-- 🖼️ Hero Banner -->
  <section class="relative">
    <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1600&q=80" 
         class="w-full h-[450px] object-cover brightness-75" alt="Fashion Banner">

    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white">
      <h2 class="text-4xl md:text-6xl font-bold mb-3 drop-shadow-lg">Your Fashion, Your Way</h2>
      <p class="text-lg md:text-xl mb-6 text-pink-100 max-w-2xl">Step into the trendiest collections crafted to make you stand out every day.</p>
      <a href="#products"
         class="bg-white text-pink-600 font-semibold px-8 py-3 rounded-full hover:bg-pink-100 transition transform hover:scale-105">
        Explore Now
      </a>
    </div>
  </section>

  <!-- 🛍️ Product Section -->
  <section id="products" class="max-w-7xl mx-auto px-6 py-16">
    <h3 class="text-3xl font-bold text-center mb-10 text-gray-800">Featured Products</h3>

    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <!-- Product Card -->
      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://images.unsplash.com/photo-1585386959984-a41552231693?auto=format&fit=crop&w=800&q=80" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Casual Sneakers</h4>
          <p class="text-gray-500 text-sm mt-1">Stylish & comfortable</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹1,299</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://images.unsplash.com/photo-1592878904946-bb9d86da3b8f?auto=format&fit=crop&w=800&q=80" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Smart Watch</h4>
          <p class="text-gray-500 text-sm mt-1">Track your fitness goals</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹3,499</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://images.unsplash.com/photo-1606813902987-7d2d96fcae2b?auto=format&fit=crop&w=800&q=80" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Leather Handbag</h4>
          <p class="text-gray-500 text-sm mt-1">Elegant & durable</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹2,999</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=800&q=80" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Wireless Headphones</h4>
          <p class="text-gray-500 text-sm mt-1">Immersive sound experience</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹1,999</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 🩷 Footer -->
  <footer class="bg-gray-900 text-gray-300 pt-12 pb-6">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-4 sm:grid-cols-2 gap-8">

      <!-- Brand -->
      <div>
        <h4 class="text-2xl font-bold text-white mb-3">Toffee Puddle</h4>
        <p class="text-gray-400 mb-4 text-sm">
          The sweetest fashion destination — bringing comfort and style together for everyone.
        </p>
        <div class="flex space-x-4">
          <a href="#" class="hover:text-pink-400"><i class="fab fa-facebook-f"></i> Facebook</a>
          <a href="#" class="hover:text-pink-400"><i class="fab fa-instagram"></i> Instagram</a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h5 class="font-semibold text-white mb-3">Quick Links</h5>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-pink-400">Home</a></li>
          <li><a href="#" class="hover:text-pink-400">Shop</a></li>
          <li><a href="#" class="hover:text-pink-400">About Us</a></li>
          <li><a href="#" class="hover:text-pink-400">FAQs</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h5 class="font-semibold text-white mb-3">Support</h5>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-pink-400">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-pink-400">Terms & Conditions</a></li>
          <li><a href="#" class="hover:text-pink-400">Return Policy</a></li>
          <li><a href="#" class="hover:text-pink-400">Contact Us</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h5 class="font-semibold text-white mb-3">Subscribe</h5>
        <p class="text-gray-400 text-sm mb-3">Get updates on latest collections and offers.</p>
        <form class="flex">
          <input type="email" placeholder="Your email" class="w-full px-3 py-2 rounded-l-lg bg-gray-800 border border-gray-700 focus:outline-none text-gray-200" />
          <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-r-lg font-semibold">Join</button>
        </form>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-700 text-center pt-4 text-sm text-gray-500">
      © 2025 Toffee Puddle. All rights reserved.
    </div>
  </footer>

  <!-- FontAwesome for Icons -->
  <script src="https://kit.fontawesome.com/a2d0b5fda1.js" crossorigin="anonymous"></script>

</body>
</html>
