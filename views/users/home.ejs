<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Toffee Puddle | Home</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans">

  <%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>





  <!-- 🖼️ Hero Banner -->
  <section class="relative">
    <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1600&q=80" 
         class="w-full h-[450px] object-cover brightness-75" alt="Fashion Banner">

    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white">
      <h2 class="text-4xl md:text-6xl font-bold mb-3 drop-shadow-lg">Your Fashion, Your Way</h2>
      <p class="text-lg md:text-xl mb-6 text-pink-100 max-w-2xl">Step into the trendiest collections crafted to make you stand out every day.</p>
      <a href="#products"
         class="bg-white text-pink-600 font-semibold px-8 py-3 rounded-full hover:bg-pink-100 transition transform hover:scale-105">
        Explore Now
      </a>
    </div>
  </section>

  <!-- 🛍️ Product Section -->
  <section id="products" class="max-w-7xl mx-auto px-6 py-16">
    <h3 class="text-3xl font-bold text-center mb-10 text-gray-800">Featured Products</h3>

    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <!-- Product Card -->
      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://i.pinimg.com/736x/db/74/89/db7489fc0fdd6057d51c762567eba685.jpg" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Casual Sneakers</h4>
          <p class="text-gray-500 text-sm mt-1">Stylish & comfortable</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹1,299</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://i.pinimg.com/736x/82/55/c8/8255c826536137e14c1ea85ddf4f940c.jpg" class="w-full h-56 object-cover" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Smart Watch</h4>
          <p class="text-gray-500 text-sm mt-1">Track your fitness goals</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹3,499</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://i.pinimg.com/1200x/59/d3/e1/59d3e1c599fa80e195223ac8a088ab1c.jpg" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Leather Handbag</h4>
          <p class="text-gray-500 text-sm mt-1">Elegant & durable</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹2,999</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>

      <div class="bg-white/80 backdrop-blur-lg shadow-md rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition transform">
        <img src="https://i.pinimg.com/736x/fb/c3/7d/fbc37d5bc8e2ee71cb7ee224e3167d15.jpg" />
        <div class="p-5">
          <h4 class="font-semibold text-lg">Wireless Headphones</h4>
          <p class="text-gray-500 text-sm mt-1">Immersive sound experience</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-pink-600 font-bold text-lg">₹1,999</span>
            <button class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Add to Cart</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>


  <!-- FontAwesome for Icons -->
  <script src="https://kit.fontawesome.com/a2d0b5fda1.js" crossorigin="anonymous"></script>

</body>
</html>


